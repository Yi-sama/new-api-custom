{
  "services": {
    "new-api": {
      "environment": {
        "NODE_TYPE": "slave",
        "SYSTEM_TASK_TYPES": "video_studio_jobs,async_task_poll",
        "UPDATE_TASK": "true",
        "VIDEO_STUDIO_DIST_DIR": "/opt/video-canvas",
        "VIDEO_STUDIO_DATA_DIR": "/app/data/video-studio",
        "TAVERN_SERVICE_KEY_FILE": "/run/new-api/tavern-service.key"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/us-whitelist/releases/production-suite-20261003-001/new-api",
          "target": "/new-api",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/opt/us-whitelist/releases/production-suite-20261003-001/video-canvas",
          "target": "/opt/video-canvas",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/opt/us-whitelist/runtime/tavern-production/tavern-service.key",
          "target": "/run/new-api/tavern-service.key",
          "read_only": true
        }
      ]
    }
  }
}
