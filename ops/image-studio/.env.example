# Copy to .env locally. Never commit the populated file.
IMAGE_STUDIO_URL=http://localhost:3002
IMAGE_STUDIO_PORT=3002
IMAGE_STUDIO_COOKIE_SECURE=false
IMAGE_STUDIO_IDENTITY_DOMAIN=studio.example.com
IMAGE_STUDIO_NAME=工作站
IMAGE_STUDIO_LOCALE=zh-CN
# Production only, when New API and the studio use sibling HTTPS hosts:
# IMAGE_STUDIO_COOKIE_DOMAIN=example.com

NEW_API_INTERNAL_ORIGIN=http://host.docker.internal:3000
# Keep generation disabled until the enabled model and per-user billing path are verified.
STUDIO_ENABLE_IMAGE_GENERATION=false
STUDIO_ENABLE_IMAGE_EDIT=false
IMAGE_STUDIO_MODEL=
IMAGE_STUDIO_EDIT_MODEL=

# Match this email to the New API root user's ID and identity domain.
OPEN_WEBUI_ADMIN_EMAIL=new-api-1@studio.example.com
OPEN_WEBUI_ADMIN_PASSWORD=replace-with-a-long-random-password
OPEN_WEBUI_ADMIN_NAME=Administrator
OPEN_WEBUI_SECRET_KEY=replace-with-a-long-random-secret
